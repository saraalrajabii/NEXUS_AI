# NEXUS environment variables.
# Copy this file to .env and fill in the values:   cp .env.example .env
# .env is listed in .gitignore — never commit it.

# ── NEXUS database (separate from Chatwoot's database) ─────────────
NEXUS_DB_NAME=nexus
NEXUS_DB_USER=nexus
# Generate one with:  openssl rand -hex 16
NEXUS_DB_PASSWORD=
# Port on your computer for psql access (5432 is often taken by other Postgres installs)
NEXUS_DB_HOST_PORT=5433

# ── NEXUS backend ───────────────────────────────────────────────────
NEXUS_BACKEND_HOST_PORT=8000
LOG_LEVEL=info
# true = restart the API automatically when backend code changes (development)
NEXUS_RELOAD=true

# ── Chatwoot service (runs in Docker next to NEXUS) ─────────────────
# Generate each with:  openssl rand -hex 64   (SECRET_KEY_BASE)   /   openssl rand -hex 16
CHATWOOT_SECRET_KEY_BASE=
CHATWOOT_DB_PASSWORD=
CHATWOOT_REDIS_PASSWORD=
CHATWOOT_HOST_PORT=3000

# ── NEXUS ↔ Chatwoot integration ────────────────────────────────────
# The backend reaches Chatwoot by its Docker service name, not localhost.
CHATWOOT_BASE_URL=http://chatwoot-rails:3000
# From Chatwoot after onboarding (see docs/lessons/lesson-01.md, Milestone 4):
#   account id   → the number in the Chatwoot URL: /app/accounts/<ID>/...
#   api token    → Profile settings → Access Token
#   webhook secret → printed by scripts/chatwoot-setup.sh
# Until these are set, the backend runs and reports Chatwoot as "not configured".
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_TOKEN=
CHATWOOT_WEBHOOK_SECRET=
